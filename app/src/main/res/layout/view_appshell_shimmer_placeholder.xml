<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerViewContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/core_space_16">

        <!-- Repeater skeleton rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/core_space_16">

            <View
                android:layout_width="@dimen/core_size_40"
                android:layout_height="@dimen/core_size_40"
                android:background="@color/core_color_stroke_subtle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/core_space_12">

                <View
                    android:layout_width="150dp"
                    android:layout_height="@dimen/core_size_12"
                    android:background="@color/core_color_stroke_subtle"
                    android:layout_marginBottom="@dimen/core_space_6" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/core_size_10"
                    android:background="@color/core_color_stroke_subtle" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/core_space_16">

            <View
                android:layout_width="@dimen/core_size_40"
                android:layout_height="@dimen/core_size_40"
                android:background="@color/core_color_stroke_subtle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/core_space_12">

                <View
                    android:layout_width="120dp"
                    android:layout_height="@dimen/core_size_12"
                    android:background="@color/core_color_stroke_subtle"
                    android:layout_marginBottom="@dimen/core_space_6" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/core_size_10"
                    android:background="@color/core_color_stroke_subtle" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/core_size_40"
                android:layout_height="@dimen/core_size_40"
                android:background="@color/core_color_stroke_subtle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/core_space_12">

                <View
                    android:layout_width="180dp"
                    android:layout_height="@dimen/core_size_12"
                    android:background="@color/core_color_stroke_subtle"
                    android:layout_marginBottom="@dimen/core_space_6" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/core_size_10"
                    android:background="@color/core_color_stroke_subtle" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
