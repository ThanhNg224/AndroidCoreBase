<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".sample.designsystem.presentation.ui.DesignSystemFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/core_space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/design_system_headline_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_8"
            android:text="@string/design_system_body_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_4"
            android:text="@string/design_system_caption_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_4"
            android:text="@string/design_system_body_emphasis_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.BodyEmphasis" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_4"
            android:text="@string/design_system_body_medium_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.BodyMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_4"
            android:text="@string/design_system_micro_sample"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Micro" />

        <!-- FrameButton #1: primary filled -->
        <com.thanhng224.androidcorebase.core.ui.components.FrameButton
            android:layout_width="match_parent"
            android:layout_height="@dimen/core_size_48"
            android:layout_marginTop="@dimen/core_space_16"
            app:coreButtonBackgroundColor="@color/core_color_primary"
            app:coreButtonCornerRadius="@dimen/core_radius_8"
            app:coreButtonShape="rectangle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/design_system_primary_button"
                android:textColor="@color/core_color_on_primary" />

        </com.thanhng224.androidcorebase.core.ui.components.FrameButton>

        <!-- FrameButton #2: outlined -->
        <com.thanhng224.androidcorebase.core.ui.components.FrameButton
            android:layout_width="match_parent"
            android:layout_height="@dimen/core_size_48"
            android:layout_marginTop="@dimen/core_space_12"
            app:coreButtonBackgroundColor="@color/core_color_surface"
            app:coreButtonCornerRadius="@dimen/core_radius_8"
            app:coreButtonShape="rectangle"
            app:coreButtonStrokeColor="@color/core_color_primary"
            app:coreButtonStrokeWidth="@dimen/core_stroke_width">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/design_system_outlined_button"
                android:textColor="@color/core_color_primary" />

        </com.thanhng224.androidcorebase.core.ui.components.FrameButton>

        <!--
            ShadowLayout's shadow only renders where the caller sets android:elevation on the
            instance itself (it does not force its own elevation internally) — see Phase 5 Task A
            notes.
        -->
        <com.thanhng224.androidcorebase.core.ui.components.ShadowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_16"
            android:elevation="@dimen/core_space_4"
            app:coreShadowBackgroundColor="@color/core_color_surface"
            app:coreShadowCornerRadius="@dimen/core_radius_8">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/core_space_16"
                android:text="@string/design_system_shadow_card_text"
                android:textAppearance="@style/TextAppearance.AndroidCoreBase.Body" />

        </com.thanhng224.androidcorebase.core.ui.components.ShadowLayout>

        <com.thanhng224.androidcorebase.core.ui.components.ThemedSwitch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_16"
            android:text="@string/design_system_switch_label" />

        <!-- FrameButton #3: triggers StyledSnackbar -->
        <com.thanhng224.androidcorebase.core.ui.components.FrameButton
            android:id="@+id/btnShowSnackbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/core_size_48"
            android:layout_marginTop="@dimen/core_space_16"
            app:coreButtonBackgroundColor="@color/core_color_primary"
            app:coreButtonCornerRadius="@dimen/core_radius_8"
            app:coreButtonShape="rectangle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/design_system_show_snackbar"
                android:textColor="@color/core_color_on_primary" />

        </com.thanhng224.androidcorebase.core.ui.components.FrameButton>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_16"
            android:text="@string/design_system_result_demo_title"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Caption" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_8"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShowLoading"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/design_system_loading_button" />

            <Button
                android:id="@+id/btnShowSuccess"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/core_space_8"
                android:layout_weight="1"
                android:text="@string/design_system_success_button" />

            <Button
                android:id="@+id/btnShowError"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/core_space_8"
                android:layout_weight="1"
                android:text="@string/design_system_error_button" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_16"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/progressDemoResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/core_space_8" />

            <TextView
                android:id="@+id/tvDemoResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AndroidCoreBase.Body" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_24"
            android:text="@string/design_system_compose_interop_headline"
            android:textAppearance="@style/TextAppearance.AndroidCoreBase.Headline" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeInteropDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/core_space_8" />

    </LinearLayout>

</ScrollView>
