<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/core_color_surface"
        android:clickable="true"
        android:focusable="true" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="@dimen/core_radius_16"
        app:cardElevation="@dimen/core_space_8"
        app:strokeWidth="@dimen/core_stroke_width"
        app:strokeColor="@color/core_color_stroke_subtle"
        app:cardBackgroundColor="@color/core_color_surface"
        tools:ignore="MergeRootFrame">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/core_space_24"
            android:paddingVertical="@dimen/core_space_20"
            android:minWidth="@dimen/core_size_150">

            <ProgressBar
                android:layout_width="@dimen/core_size_40"
                android:layout_height="@dimen/core_size_40"
                android:indeterminateTint="@color/core_color_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvLoaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/core_space_12"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.AndroidXmlBase.Body"
                android:textColor="@color/core_color_on_surface"
                android:textStyle="bold"
                tools:text="Loading…" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
